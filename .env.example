# ==============================================================================
# EDGELEDGER — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and configure your environment-specific values:
#   cp .env.example .env.local
#
# Next.js automatically loads .env.local on application start.
# Variables prefixed with NEXT_PUBLIC_ are accessible in the browser bundle.
# All other variables remain server-side only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CLOUD & ROW LEVEL SECURITY (RLS)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Dashboard -> Settings -> API.
# When provided, EDGELEDGER connects to your PostgreSQL instance with full RLS.
# If left blank, EDGELEDGER automatically runs in Local Persistent Storage mode.

# Project REST URL (e.g., https://yourprojectid.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Anonymous API Key (used for browser and RLS-authenticated queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (SERVER-SIDE ONLY — NEVER expose to the client)
# Used for backend database migrations, durable worker queues, and admin tasks.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ------------------------------------------------------------------------------
# 2. APPLICATION ENVIRONMENT & LOCALIZATION
# ------------------------------------------------------------------------------
# Application runtime mode: 'development' | 'staging' | 'production' | 'test'
NEXT_PUBLIC_APP_ENV=development

# Base URL of the EDGELEDGER instance
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Default Portfolio Base Reporting Currency (ISO 4217 code)
NEXT_PUBLIC_DEFAULT_BASE_CURRENCY=USD

# Pre-populate sample demo trading accounts, trades, rules, and journal on first load
# Set to 'false' for a clean, blank production database.
NEXT_PUBLIC_ENABLE_DEMO_DATA=false

# Enable Worked Fixtures 1 & 2 for prop-firm compliance tests and trailing drawdown audits
NEXT_PUBLIC_WORKED_FIXTURES=true

# ------------------------------------------------------------------------------
# 3. QUANTITATIVE & RISK ENGINE PARAMETERS
# ------------------------------------------------------------------------------
# Precision digits for decimal.js calculations (default: 28 decimal places)
# Ensures zero IEEE-754 binary floating point precision loss in financial figures.
NEXT_PUBLIC_DECIMAL_PRECISION=28

# Intraday risk rule evaluation & surveillance polling cadence (in milliseconds)
# Evaluates open equity against daily loss limit, max drawdown, and trailing floors.
NEXT_PUBLIC_RISK_CHECK_INTERVAL_MS=5000
