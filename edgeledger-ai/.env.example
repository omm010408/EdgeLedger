# EDGELEDGER AI - Environment Configuration Template
# Copy this file to .env and adjust variables as needed.

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ollama Local Server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Hugging Face (Optional: for private datasets or gated base models)
HUGGINGFACE_TOKEN=
HF_HOME=./models/hf_cache

# Paths (Relative to edgeledger-ai project root)
DATASET_DIR=./data
MODELS_DIR=./models
CONFIG_DIR=./configs
